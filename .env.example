# Copy to .env in the fleet home (the repository root by default; FLEETQ_HOME overrides).
# Real environment variables override these values. Full list: docs/configuration.md

# Coordinator database. The default matches docker-compose.yml.
FLEETQ_DSN=postgresql://fleetq:fleetq@localhost:5433/fleetq

# Worker side only (deploy/install_worker.sh writes this into ~/fleetq/.env on each worker):
# the coordinator's address. When set it wins over FLEETQ_DSN. Leave unset on the coordinator.
# FLEETQ_COORDINATOR=192.168.1.50

# Dashboard API keys, comma-separated; one per integrating system.
# Generate: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
# Empty = open API (development on a trusted LAN only).
FLEETQ_API_KEYS=

# Dashboard listener
DASHBOARD_PORT=8787
DASHBOARD_BIND=0.0.0.0
DASHBOARD_INTERVAL=15

# Crawl budgets: pages per crawl when the request gives no limit, and the ceiling no request may exceed.
FLEETQ_CRAWL_DEFAULT_LIMIT=100
FLEETQ_CRAWL_MAX_LIMIT=2000

# Extra directories with handler modules, colon-separated (also: fleetq worker --handlers DIR).
# FLEETQ_HANDLERS=/opt/my-handlers

# User-Agent for the fetch/sitemap/render handlers. Put a contact URL in it.
# FLEETQ_USER_AGENT=fleetq/0.1 (+https://example.com/bot; polite crawler)
